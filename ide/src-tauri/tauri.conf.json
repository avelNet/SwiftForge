{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SwiftForge",
  "version": "0.1.0",
  "identifier": "net.avel.swiftforge",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "SwiftForge", "width": 1280, "height": 800, "minWidth": 840, "minHeight": 520 }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; worker-src 'self' blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": false }
}
