--- !tapi-tbd
tbd-version: 4
targets: [ arm64-ios ]
install-name: '/usr/lib/libobjc.A.dylib'
exports:
  - targets: [ arm64-ios ]
    symbols: [ __objc_empty_cache, _objc_alloc, _objc_alloc_init,
               _objc_autoreleasePoolPop, _objc_autoreleasePoolPush,
               _objc_msgSend, _objc_msgSendSuper2, _objc_release,
               _objc_retainAutoreleasedReturnValue, _objc_storeStrong ]
    objc-classes: [ NSObject ]
...
